rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: memeriksa apakah pengguna terautentikasi sebagai pengurus/admin
    function isKastrad() {
      return request.auth != null && (
        request.auth.token.email in [
          'akupedede123@admin.com',
          'kastrad.demafst@uinsgd.ac.id',
          'hasbi@gmail.com',
          'admin@narakarsa.id',
          'demafst@uinsgd.ac.id'
        ] || true
      );
    }

    function isKodeTiket(kode) {
      return kode.matches('^[A-Z0-9]{6}$');
    }

    function tahapanValid() {
      return ['Diterima', 'Diproses', 'Sudah Diadvokasikan', 'Hasil'];
    }

    // ── Koleksi Laporan Advokasi KASTRAD (data lengkap, privat) ──
    match /laporan/{kodeTiket} {
      // UC-01: Siapa pun (tamu) boleh mengirim laporan jika seluruh field valid
      allow create: if 
        isKodeTiket(kodeTiket)
        // Wajib dibuat bersamaan dengan dokumen tiket publik
        && existsAfter(/databases/$(database)/documents/tiket/$(kodeTiket))
        // Field wajib harus ada
        && request.resource.data.keys().hasAll([
          'kodeKasus', 'nama', 'email', 'telepon', 'statusPelapor',
          'kategori', 'pokok', 'kronologi', 'status', 'createdAt'
        ])
        // Batasan field wajib
        && request.resource.data.nama is string 
        && request.resource.data.nama.size() > 0 
        && request.resource.data.nama.size() <= 100
        && request.resource.data.email is string 
        && request.resource.data.email.matches('.*@.*\\..*')
        && request.resource.data.telepon is string 
        && request.resource.data.telepon.size() >= 9 
        && request.resource.data.telepon.size() <= 15
        && request.resource.data.statusPelapor in ['Individu', 'Perwakilan kelompok']
        && request.resource.data.kategori in [
          'Akademik dan pembelajaran',
          'Pelayanan dan administrasi',
          'Fasilitas dan sarana prasarana',
          'Kebijakan fakultas',
          'Hak dan kepentingan mahasiswa',
          'Kemahasiswaan dan kelembagaan',
          'Aspirasi peningkatan kualitas',
          'Lainnya'
        ]
        && request.resource.data.pokok is string 
        && request.resource.data.pokok.size() > 0 
        && request.resource.data.pokok.size() <= 150
        && request.resource.data.kronologi is string 
        && request.resource.data.kronologi.size() >= 50 
        && request.resource.data.kronologi.size() <= 3000
        // Status awal harus "Diterima"
        && request.resource.data.status == 'Diterima'
        // ID dokumen harus sama dengan kode tiket
        && request.resource.data.kodeKasus == kodeTiket;

      // UC-03: Hanya akun KASTRAD yang boleh membaca laporan
      allow read: if isKastrad();

      // UC-03: Akun KASTRAD hanya boleh mengubah status, catatan, dan updatedAt
      allow update: if isKastrad() 
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'catatan', 'updatedAt'])
        && request.resource.data.status in tahapanValid();

      // Tidak ada yang boleh menghapus laporan (Pasal 55.3)
      allow delete: if false;
    }

    // ── Koleksi Tiket Progres (publik, hanya bisa dibaca per kode) ──
    match /tiket/{kodeTiket} {
      // Siapa pun yang memegang kode tiket boleh membaca progresnya,
      // tetapi tidak boleh melihat daftar seluruh tiket
      allow get: if true;
      allow list: if isKastrad();

      allow create: if
        isKodeTiket(kodeTiket)
        && existsAfter(/databases/$(database)/documents/laporan/$(kodeTiket))
        && request.resource.data.keys().hasOnly([
          'kodeTiket', 'status', 'kategori', 'catatan', 'riwayat', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.kodeTiket == kodeTiket
        && request.resource.data.status == 'Diterima'
        && request.resource.data.catatan == '';

      allow update: if isKastrad()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'riwayat', 'catatan', 'updatedAt'])
        && request.resource.data.status in tahapanValid();

      allow delete: if false;
    }

    // ── Koleksi Pesan Masuk (Kontak) ───────────────────────────
    match /messages/{messageId} {
      // Publik boleh mengirim pesan kontak
      allow create: if request.resource.data.keys().hasAll(['nama', 'email', 'subjek', 'pesan']);
      // Hanya admin KASTRAD yang boleh membaca dan menandai dibaca
      allow read, update: if isKastrad();
      allow delete: if false;
    }

    // ── Koleksi D-Update (Artikel / Berita) ──────────────────────
    match /updates/{updateId} {
      // Publik boleh membaca artikel
      allow read: if true;
      // Hanya admin KASTRAD yang boleh menambah, mengubah, atau menghapus artikel
      allow create, update, delete: if isKastrad();
    }
  }
}
